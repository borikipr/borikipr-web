# Application -----------------------------------------------------------------
# Required, public: canonical origin without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com
# Optional, server-only: development | preview | production.
APP_ENV=development
# Optional, server-only. Keep false until the controlled English launch.
MULTILINGUAL_ENABLED=false

# Translation worker -----------------------------------------------------------
# Optional, server-only. Disabled by default; public requests never run it.
TRANSLATION_WORKER_ENABLED=false
# Optional, server-only. Supported future value: google-cloud-translation.
TRANSLATION_PROVIDER=
# Required only when the Google worker is deliberately enabled.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_TRANSLATION_LOCATION=global
# Authentication mode: vercel-wif in Vercel; adc only for explicit local use.
GOOGLE_CLOUD_AUTH_MODE=
# Required only for enabled Vercel WIF processing. These are identifiers, not
# credentials; keep actual production values in Vercel's server-only settings.
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_CLOUD_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CLOUD_WORKLOAD_IDENTITY_POOL_ID=
GOOGLE_CLOUD_WORKLOAD_IDENTITY_PROVIDER_ID=
# Optional. A supplied audience must exactly match the configured provider.
GOOGLE_CLOUD_WORKLOAD_IDENTITY_AUDIENCE=
# Optional, server-only glossary resource ID (not a path); disabled when empty.
GOOGLE_CLOUD_TRANSLATION_GLOSSARY_ID=
# Local development only. Vercel production must use WIF and cannot use ADC.
# Do not commit the credential file or this value.
# GOOGLE_APPLICATION_CREDENTIALS=
# Optional bounded worker controls.
TRANSLATION_WORKER_BATCH_SIZE=10
TRANSLATION_WORKER_CONCURRENCY=2
TRANSLATION_WORKER_LOCK_TIMEOUT_MS=600000
TRANSLATION_PROVIDER_TIMEOUT_MS=30000
TRANSLATION_WORKER_ID=borikipr
# Vercel OIDC tokens are obtained at runtime through @vercel/oidc. Never place
# an OIDC token or credential JSON document in this file.

# Neon PostgreSQL --------------------------------------------------------------
# Required, server-only. Use an isolated development/preview branch locally.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Cloudflare R2 ---------------------------------------------------------------
# Required for media/document workflows, server-only.
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_private_bucket
# Optional, public. Only for intentionally public property/testimonial media.
R2_PUBLIC_BASE_URL=https://media.example.com

# Email / Resend ---------------------------------------------------------------
# Required for delivery, server-only. Persistence remains authoritative if a
# retryable delivery attempt fails.
RESEND_API_KEY=re_example
CONTACT_FROM_EMAIL=notifications@example.com
CONTACT_TO_EMAIL=internal@example.com

# Admin authentication --------------------------------------------------------
# Required, server-only. Generate a high-entropy secret of at least 32 bytes.
SESSION_SECRET=replace_with_a_long_random_secret

# Cron and public throttling ---------------------------------------------------
# Required, server-only. Vercel sends CRON_SECRET as a Bearer token.
CRON_SECRET=replace_with_a_long_random_secret
# Required, server-only. HMAC key; at least 32 characters and distinct from all
# other secrets.
RATE_LIMIT_HASH_SECRET=replace_with_a_distinct_long_random_secret

# Public analytics -------------------------------------------------------------
# Optional, public. Omit to disable the corresponding client integration.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id

# Authenticated analytics dashboard providers --------------------------------
# Optional, server-only.
CLARITY_API_TOKEN=
CLARITY_PROJECT_ID=
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
VERCEL_API_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=
VERCEL_ANALYTICS_TEAM_ID=
VERCEL_ANALYTICS_TEAM_SLUG=

# Controlled maintenance ------------------------------------------------------
# Never enable by default. Required only by the explicitly guarded historical
# Priority Registration backfill apply command.
PRIORITY_REGISTRATION_BACKFILL_APPLY=NO
