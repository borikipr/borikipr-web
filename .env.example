# Application -----------------------------------------------------------------
# Required, public: canonical origin without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com
# Optional, server-only: development | preview | production.
APP_ENV=development
# Optional, server-only. Keep false until the controlled English launch.
MULTILINGUAL_ENABLED=false

# Translation worker -----------------------------------------------------------
# Optional, server-only. Disabled by default; public requests never run it.
TRANSLATION_WORKER_ENABLED=false
# Optional, server-only. The only allowed production value is azure-translator.
# Unknown and retired provider IDs fail closed; there is no automatic fallback.
TRANSLATION_PROVIDER=
# Required when the Azure worker is enabled. All three are
# server-only. Never expose the resource key through NEXT_PUBLIC_* variables.
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_KEY=
# Optional bounded worker controls.
# Production accepts only 1/1. Larger isolated-test values fail closed in production.
TRANSLATION_WORKER_BATCH_SIZE=1
TRANSLATION_WORKER_CONCURRENCY=1
TRANSLATION_WORKER_LOCK_TIMEOUT_MS=600000
TRANSLATION_PROVIDER_TIMEOUT_MS=30000
TRANSLATION_WORKER_ID=borikipr

# Neon PostgreSQL --------------------------------------------------------------
# Required, server-only. Use an isolated development/preview branch locally.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Cloudflare R2 ---------------------------------------------------------------
# Required for media/document workflows, server-only.
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_private_bucket
# Optional, public. Only for intentionally public property/testimonial media.
R2_PUBLIC_BASE_URL=https://media.example.com

# Email / Resend ---------------------------------------------------------------
# Required for delivery, server-only. Persistence remains authoritative if a
# retryable delivery attempt fails.
RESEND_API_KEY=re_example
CONTACT_FROM_EMAIL=notifications@example.com
CONTACT_TO_EMAIL=internal@example.com

# Admin authentication --------------------------------------------------------
# Required, server-only. Generate a high-entropy secret of at least 32 bytes.
SESSION_SECRET=replace_with_a_long_random_secret

# Cron and public throttling ---------------------------------------------------
# Required, server-only. Vercel sends CRON_SECRET as a Bearer token.
CRON_SECRET=replace_with_a_long_random_secret
# Optional dedicated secret for the translation scheduler; falls back to CRON_SECRET.
TRANSLATION_CRON_SECRET=
# Required, server-only. HMAC key; at least 32 characters and distinct from all
# other secrets.
RATE_LIMIT_HASH_SECRET=replace_with_a_distinct_long_random_secret

# Electronic-signature evidence (server-only) -------------------------------
# JSON object mapping positive integer key versions to base64url-encoded keys
# of at least 32 random bytes, for example {"1":"<base64url>"}. Never expose
# these variables to NEXT_PUBLIC_* or reuse authentication/cron secrets.
SIGNATURE_EVENT_HMAC_KEYS_JSON=
SIGNATURE_EVENT_HMAC_CURRENT_VERSION=
# Independent base64url-encoded key of at least 32 random bytes used only to
# pseudonymize minimized network evidence.
SIGNATURE_NETWORK_EVIDENCE_HMAC_KEY=
# Public signer transport remains closed unless explicitly enabled by a
# separately authorized launch. Keep false throughout readiness drills.
SIGNING_PUBLIC_ENABLED=false
# Counsel/privacy-approved retention policy. Leave blank to fail closed and
# keep all completed evidence cleanup disabled.
SIGNATURE_RETENTION_POLICY_JSON=
# Versioned, approved es-PR/en-US signer privacy disclosure. Server-only JSON.
SIGNATURE_PRIVACY_DISCLOSURE_JSON=
SIGNATURE_REPLY_TO_EMAIL=ivonneerickson@borikipr.com

# Public analytics -------------------------------------------------------------
# Optional, public. Omit to disable the corresponding client integration.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id

# Authenticated analytics dashboard providers --------------------------------
# Optional, server-only.
CLARITY_API_TOKEN=
CLARITY_PROJECT_ID=
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
VERCEL_API_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=
VERCEL_ANALYTICS_TEAM_ID=
VERCEL_ANALYTICS_TEAM_SLUG=

# Controlled maintenance ------------------------------------------------------
# Never enable by default. Required only by the explicitly guarded historical
# Priority Registration backfill apply command.
PRIORITY_REGISTRATION_BACKFILL_APPLY=NO
