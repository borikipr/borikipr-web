# Application -----------------------------------------------------------------
# Required, public: canonical origin without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com
# Optional, server-only: development | preview | production.
APP_ENV=development

# Neon PostgreSQL --------------------------------------------------------------
# Required, server-only. Use an isolated development/preview branch locally.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Cloudflare R2 ---------------------------------------------------------------
# Required for media/document workflows, server-only.
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_private_bucket
# Optional, public. Only for intentionally public property/testimonial media.
R2_PUBLIC_BASE_URL=https://media.example.com

# Email / Resend ---------------------------------------------------------------
# Required for delivery, server-only. Persistence remains authoritative if a
# retryable delivery attempt fails.
RESEND_API_KEY=re_example
CONTACT_FROM_EMAIL=notifications@example.com
CONTACT_TO_EMAIL=internal@example.com

# Admin authentication --------------------------------------------------------
# Required, server-only. Generate a high-entropy secret of at least 32 bytes.
SESSION_SECRET=replace_with_a_long_random_secret

# Cron and public throttling ---------------------------------------------------
# Required, server-only. Vercel sends CRON_SECRET as a Bearer token.
CRON_SECRET=replace_with_a_long_random_secret
# Required, server-only. HMAC key; at least 32 characters and distinct from all
# other secrets.
PUBLIC_RATE_LIMIT_SECRET=replace_with_a_distinct_long_random_secret

# Public analytics -------------------------------------------------------------
# Optional, public. Omit to disable the corresponding client integration.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id

# Authenticated analytics dashboard providers --------------------------------
# Optional, server-only.
CLARITY_API_TOKEN=
CLARITY_PROJECT_ID=
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
VERCEL_API_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=
VERCEL_ANALYTICS_TEAM_ID=
VERCEL_ANALYTICS_TEAM_SLUG=

# Controlled maintenance ------------------------------------------------------
# Never enable by default. Required only by the explicitly guarded historical
# Priority Registration backfill apply command.
PRIORITY_REGISTRATION_BACKFILL_APPLY=NO
