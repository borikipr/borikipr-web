{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "borikipr-translation-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": false,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
